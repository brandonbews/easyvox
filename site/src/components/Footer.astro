---
import { REPO_URL, repoUrl } from "../config";

// null while the repo is private (REPO_PUBLIC in src/config.ts).
const license = repoUrl("LICENSE");
const notices = repoUrl("packaging/THIRD_PARTY_NOTICES.html");
---

<footer class="site-footer">
  <div class="site-footer-inner">
    {
      license && notices ? (
        <p>
          EasyVox is free and open source, under the <a href={license}>MIT license</a>. Its{" "}
          <a href={REPO_URL}>source</a> and <a href={notices}>third-party notices</a> are on GitHub.
        </p>
      ) : (
        <p>
          EasyVox is free and open source, under the MIT license. Its third-party notices are in the
          app, under Settings → About.
        </p>
      )
    }
    <p>
      Speech models: Parakeet TDT 0.6B v2 by NVIDIA (CC BY 4.0) and Whisper base.en by OpenAI (Apache
      2.0). EasyVox isn't affiliated with or endorsed by NVIDIA or OpenAI.
    </p>
  </div>
</footer>
