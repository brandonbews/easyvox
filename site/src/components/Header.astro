---
// The site header: the lockup, the nav, and the way to install. The nav is three or four short
// links, so it stays inline on a phone rather than hiding behind a menu button.
import { DOWNLOAD_URL, REPO_PUBLIC, REPO_URL } from "../config";
import Lockup from "./Lockup.astro";

const here = Astro.url.pathname;
const inDocs = here.startsWith("/docs");
const inBenchmarks = here.startsWith("/benchmarks");
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="lockup-link" href="/"><Lockup /></a>
    <nav class="site-nav" aria-label="Site">
      <a href="/benchmarks" aria-current={inBenchmarks ? "page" : undefined}>Benchmarks</a>
      <a href="/docs" aria-current={inDocs ? "true" : undefined}>Docs</a>
      {REPO_PUBLIC && <a class="site-nav-github" href={REPO_URL}>GitHub</a>}
      <a class="button button-primary button-small site-nav-download" href={DOWNLOAD_URL}>Download</a>
    </nav>
  </div>
</header>
