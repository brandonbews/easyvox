---
// Every page: head, header, footer. No JavaScript: nothing here (or anywhere on the site)
// renders a client component, so Astro emits no <script>.
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { NOINDEX, SITE_NAME, SITE_URL, siteUrl } from "../config";
import "../styles/global.css";

interface Props {
  // The page's own title; " · EasyVox" is added. Omit it for the homepage.
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: simple, local, fast speech-to-text for the Mac`;
// A canonical URL and og:url need the domain (SITE_URL in src/config.ts), attached at launch.
const canonical = SITE_URL ? siteUrl(Astro.url.pathname) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {NOINDEX && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    {/* The page backgrounds in global.css: paper, light and dark. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1c1c1e" />
    {
      /* Icons (design/assets/web). The .ico (16, 32, 48) is the fallback; sizes="32x32" stops
         Chrome preferring it over the SVG, whose ink follows the colour scheme. */
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      /* Link previews. og-image.png is the dark card (re-rendered from design board 20 with the
         real requirements). Its URL is relative until the domain is attached at launch, when
         siteUrl() makes it absolute, as og:image needs. */
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={siteUrl("/og-image.png")} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The EasyVox mark above the line “Hold ⌥Space, talk, let go.”" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
