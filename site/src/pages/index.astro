---
// The homepage: the pitch and the demo, four features, the two models, install. It doesn't
// explain dictation and never mentions AI. Numbers match /benchmarks.
import Demo from "../components/Demo.astro";
import { DOWNLOAD_URL } from "../config";
import Base from "../layouts/Base.astro";
---

<Base description="Simple, local, fast, free speech-to-text for the Mac. Open source, MIT license.">
  <main id="main" class="landing">
    <section class="hero container" aria-labelledby="top">
      <h1 id="top">Simple, local, fast, free speech-to-text.</h1>
      <div class="actions">
        <a class="button button-primary" href={DOWNLOAD_URL}>Download</a>
        <a class="button button-secondary" href="/docs/building">Build from source</a>
      </div>
      <p class="meta-line">macOS 26 or later <span aria-hidden="true">·</span> Apple silicon <span aria-hidden="true">·</span> MIT license</p>
      <Demo />
    </section>

    <section class="section section-features container" aria-label="Features">
      <ul class="features">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.6 13.2A7.5 7.5 0 1 0 6.4 6.9M6.6 3.6l-0.4 3.5 3.5 0.3M12 8.25V12l2.75 2"></path></svg>
          <h3>Fast</h3>
          <p>Your text is in place under half a second after you let go.</p>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.75" y="8.25" width="18.5" height="7.5" rx="3.75"></rect><path d="M6.5 12h4.75M13.25 12h1.5M16.75 12h0.75"></path></svg>
          <h3>Preview as you talk</h3>
          <p>Your words appear while you're still talking.</p>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.75" y="4.75" width="16.5" height="11.5" rx="1.75"></rect><path d="M2 19.25h20M10 9v3.5M12 8v5.5M14 9.25v3"></path></svg>
          <h3>Local</h3>
          <p>Everything runs on your Mac. Nothing you say goes to a server.</p>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="5.5" r="2.25"></circle><circle cx="17" cy="5.5" r="2.25"></circle><circle cx="12" cy="18.5" r="2.25"></circle><path d="M7 7.75v1.25a3 3 0 0 0 3 3h4a3 3 0 0 0 3-3V7.75M12 12v4.25"></path></svg>
          <h3>Free and open source</h3>
          <p>MIT license. Fork it, change it, share it.</p>
        </li>
      </ul>
    </section>

    <section class="section container" aria-labelledby="models">
      <div class="section-head">
        <h2 id="models">Two models</h2>
      </div>
      <ul class="models">
        <li class="model">
          <p class="badge">Default</p>
          <h3>Parakeet TDT 0.6B v2</h3>
          <p>The best all-round model. A 539 MB download.</p>
          <p class="model-credit">
            By NVIDIA, under CC BY 4.0. <a href="https://huggingface.co/nvidia/parakeet-tdt-0.6b-v2">Model card</a>
          </p>
        </li>
        <li class="model">
          <p class="badge">The small one</p>
          <h3>Whisper base.en</h3>
          <p>For an 8 GB Mac: smaller, but less accurate. An 85 MB download.</p>
          <p class="model-credit">
            By OpenAI, under Apache 2.0. <a href="https://huggingface.co/openai/whisper-base.en">Model card</a>
          </p>
        </li>
      </ul>
      <p class="caveat">Why these two? I compared <a href="/benchmarks">a lot</a> of them.</p>
    </section>

    <section class="cta container" aria-labelledby="install">
      <h2 id="install">Get EasyVox.</h2>
      <div class="actions">
        <a class="button button-primary" href={DOWNLOAD_URL}>Download</a>
        <a class="button button-secondary" href="/docs/building">Build from source</a>
      </div>
      <div class="requirements">
        <h3 id="requirements">Requirements</h3>
        <ul>
          <li>A Mac with Apple silicon</li>
          <li>macOS 26 or later</li>
          <li>English, for now</li>
        </ul>
      </div>
    </section>
  </main>
</Base>
